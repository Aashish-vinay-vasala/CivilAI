# Copy to backend/env.yaml and fill in real values, then run deploy/deploy-backend.ps1
# backend/env.yaml is gitignored — never commit it.
#
# Passed to Cloud Run via: gcloud run deploy --env-vars-file backend/env.yaml

# ── Required ──────────────────────────────────────────────────────────────────
GROQ_API_KEY: "gsk_..."
GEMINI_API_KEY: "..."
SUPABASE_URL: "https://your-project.supabase.co"
SUPABASE_SECRET_KEY: "your-service-role-key"
HUGGINGFACE_TOKEN: "hf_..."

# ── Production settings ──────────────────────────────────────────────────────
DEBUG: "false"
ENVIRONMENT: "production"
AUTH_REQUIRED: "true"
# Comma-separated. Include both Firebase Hosting domains for gen-lang-client-0881995245,
# plus any custom domain you attach.
ALLOWED_ORIGINS: "https://gen-lang-client-0881995245.web.app,https://gen-lang-client-0881995245.firebaseapp.com"

# ── Optional (uncomment / fill in as needed) ────────────────────────────────
# GROQ_API_KEY_2: "..."
# GROQ_API_KEY_3: "..."
# JUDGE_HF_MODEL: "..."
# REDIS_URL: "redis://..."
# ELEVENLABS_API_KEY: "..."
# MEM0_API_KEY: "..."
# ZEP_BASE_URL: "..."
# ZEP_API_KEY: "..."
# LANGCHAIN_TRACING_V2: "true"
# LANGCHAIN_API_KEY: "..."
# LANGCHAIN_PROJECT: "civilai"
# OTEL_EXPORTER_OTLP_ENDPOINT: "..."
# PVPORCUPINE_ACCESS_KEY: "..."
