# Root env file for `docker compose up`. Copy to `.env` and fill in real values:
#   cp .env.example .env

# ── Backend (required) ───────────────────────────────────────────────────────
GROQ_API_KEY=gsk_...
GEMINI_API_KEY=...
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=your-service-role-key
HUGGINGFACE_TOKEN=hf_...

# ── Backend (optional) ───────────────────────────────────────────────────────
RESEND_API_KEY=re_...

# ── Frontend (required for Supabase auth in the browser) ────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
